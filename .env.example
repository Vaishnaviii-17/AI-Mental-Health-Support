# =====================================
# Backend
# =====================================

PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mental_health_db
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL (used by backend for CORS)
FRONTEND_URL=http://localhost:5173

# =====================================
# Frontend (Vite)
# =====================================

VITE_API_URL=http://localhost:5000/api

# =====================================
# Local translation
# =====================================

ML_INFERENCE_URL=http://127.0.0.1:5001

# First NLLB request may take longer while the model loads
NLLB_TRANSLATION_TIMEOUT_MS=120000

# =====================================
# Gemini translation fallback
# =====================================

GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
TRANSLATION_TIMEOUT_MS=20000


# Whisper speech-to-text.
# Use tiny.en for English-only local development.
# For Hindi/Marathi voice journaling, use a multilingual model such as tiny,
# base, small, medium, or large.
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Server-side translation for Hindi/Marathi journal analysis.
# Supported providers: auto, gemini, libretranslate, disabled
#TRANSLATION_PROVIDER=auto
TRANSLATION_TIMEOUT_MS=20000
#TRANSLATION_API_KEY= 
#LIBRETRANSLATE_URL= 
GEMINI_TRANSLATION_MODEL=gemini-3.8-flash

#Hugging Face API Key
HF_TOKEN=
