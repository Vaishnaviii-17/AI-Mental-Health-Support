# =====================================
# Backend
# =====================================

PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mental_health_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# Frontend URL (used by backend for CORS)
FRONTEND_URL=http://localhost:5173

# =====================================
# Frontend (Vite)
# =====================================

VITE_API_URL=http://localhost:5000/api

# =====================================
# AI
# =====================================

GEMINI_API_KEY=your_gemini_api_key
ML_INFERENCE_URL=http://127.0.0.1:5001
INFERENCE_TIMEOUT_MS=15000
TRANSCRIPTION_TIMEOUT_MS=60000
TRANSCRIPTION_MAX_AUDIO_BYTES=10485760

# Whisper speech-to-text.
# Use tiny.en for English-only local development.
# For Hindi/Marathi voice journaling, use a multilingual model such as tiny,
# base, small, medium, or large.
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Server-side translation for Hindi/Marathi journal analysis.
# Supported providers: auto, gemini, libretranslate, disabled
TRANSLATION_PROVIDER=auto
TRANSLATION_TIMEOUT_MS=20000
TRANSLATION_API_KEY= optional_for_now
LIBRETRANSLATE_URL= optional_for_now
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash

#Hugging Face API Key
HF_TOKEN=hf_your_api_key

